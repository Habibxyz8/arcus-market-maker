# Arcus Market Maker - Environment Template
# Copy to .env and fill in your values. Never commit .env
# See Phase 5: Credential Security

# Trading mode: PAPER | TESTNET | LIVE (default PAPER)
TRADING_MODE=PAPER

# Arcus API credentials (from Arcus dashboard - never share)
ARCUS_API_KEY=
ARCUS_API_SECRET=
ARCUS_ACCOUNT_ADDRESS=
ARCUS_ACCOUNT_INDEX=0

# Arcus endpoints (defaults per official docs)
ARCUS_REST_URL=https://api.arcus.xyz
ARCUS_WS_URL=wss://ws.arcus.xyz
ARCUS_TESTNET_REST_URL=https://testnet-api.arcus.xyz
ARCUS_TESTNET_WS_URL=wss://testnet-ws.arcus.xyz

# Strategy defaults (micro TP/SL 10x leverage)
MARKET=BTC-USD
ORDER_SIZE=0.001
ORDER_SIZE_USD=50
MAX_ORDER_SIZE=0.01
BID_SPREAD_BPS=6
ASK_SPREAD_BPS=6
QUOTE_REFRESH_INTERVAL_MS=500
MAX_INVENTORY=0.05
MAX_EXPOSURE=5000
MAX_DAILY_LOSS=500
MAX_OPEN_ORDERS=2
MAX_ORDER_AGE_SEC=30
MIN_EXPECTED_PROFIT=0.01
MIN_EXPECTED_EDGE_BPS=1
INVENTORY_SKEW_FACTOR=0.5
MAKER_FEE_BPS=0
DEAD_MANS_SWITCH_TIMEOUT_SEC=30
ACCOUNT_BALANCE=100
LEVERAGE=10
TAKE_PROFIT_USD=0.015
STOP_LOSS_USD=0.009
STRATEGY_PRESET=guru
SUPPORTED_MARKETS=BTC-USD,ETH-USD,SOL-USD,NVDA-USD,TSLA-USD

# Backend
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./arcus_maker.db
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
